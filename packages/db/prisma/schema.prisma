// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// TENANT & AUTH MODELS
// ========================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  domain    String?  @unique
  logoUrl   String?
  timezone  String   @default("Asia/Kolkata")
  currency  String   @default("INR")
  locale    String   @default("en-IN")
  region    String   @default("in") // for data residency
  
  // Subscription & Billing
  planId       String
  plan         Plan         @relation(fields: [planId], references: [id])
  subscription Subscription?
  
  // Theme & Branding
  theme Json? // JSON object for theme customization
  
  // Settings
  settings Json? // JSON object for various settings
  
  // Relations
  outlets        Outlet[]
  users          User[]
  customers      Customer[]
  vendors        Vendor[]
  campaigns      Campaign[]
  coupons        Coupon[]
  webhookEvents  WebhookEvent[]
  categories     Category[]
  menuItems      MenuItem[]
  modifierGroups ModifierGroup[]
  ingredients    Ingredient[]
  connectors     Connector[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([domain])
  @@index([planId])
  @@map("tenants")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  name     String
  phone    String?
  avatar   String?
  
  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Auth
  clerkId     String? @unique
  isActive    Boolean @default(true)
  lastLoginAt DateTime?
  
  // Role & Permissions
  roles UserRole[]
  
  // Relations
  timesheets     Timesheet[]
  shifts         Shift[]
  auditLogs      AuditLog[]
  orders         Order[]         @relation("OrderUser")
  purchaseOrders PurchaseOrder[] @relation("POCreatedBy")
  grns           GoodsReceivedNote[] @relation("GRNReceivedBy")
  transfers      Transfer[]      @relation("TransferCreatedBy")
  stockMovements StockMovement[] @relation("StockMovementUser")
  reservations   Reservation[]   @relation("ReservationCreatedBy")
  campaigns      Campaign[]      @relation("CampaignCreatedBy")
  coupons        Coupon[]        @relation("CouponCreatedBy")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([clerkId])
  @@index([email])
  @@map("users")
}

model Role {
  id          String @id @default(cuid())
  name        String
  description String?
  permissions Json   // Array of permission strings
  
  // Relations
  userRoles UserRole[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@map("roles")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  // Outlet-specific roles (optional)
  outletId String?
  outlet   Outlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@unique([userId, roleId, outletId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ========================================
// OUTLET & LOCATION MODELS
// ========================================

model Outlet {
  id      String @id @default(cuid())
  name    String
  address String
  city    String
  state   String
  country String @default("India")
  pincode String
  phone   String?
  email   String?
  
  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Settings
  timezone     String  @default("Asia/Kolkata")
  currency     String  @default("INR")
  isActive     Boolean @default(true)
  
  // Business details
  gstNumber    String?
  fssaiNumber  String?
  licenseNumber String?
  
  // Layout & Configuration
  floorPlan    Json? // JSON for table layout
  printerConfig Json? // Printer settings
  
  // Relations
  userRoles    UserRole[]
  tables       Table[]
  orders       Order[]
  inventory    StockItem[]
  warehouses   Warehouse[]
  reservations Reservation[]
  shifts       Shift[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([isActive])
  @@map("outlets")
}

// ========================================
// TABLE & FLOOR MANAGEMENT
// ========================================

model Table {
  id       String @id @default(cuid())
  number   String
  name     String?
  capacity Int    @default(4)
  
  // Outlet
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  
  // Layout
  x        Float? // X coordinate in floor plan
  y        Float? // Y coordinate in floor plan
  width    Float? @default(100)
  height   Float? @default(100)
  
  // Status
  status   TableStatus @default(AVAILABLE)
  isActive Boolean     @default(true)
  
  // Relations
  orders       Order[]
  reservations Reservation[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([outletId, number])
  @@index([outletId])
  @@index([status])
  @@map("tables")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  OUT_OF_ORDER
}

// ========================================
// MENU & PRODUCT MODELS
// ========================================

model Category {
  id          String @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int    @default(0)
  isActive    Boolean @default(true)
  
  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Relations
  menuItems MenuItem[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([isActive])
  @@map("categories")
}

model MenuItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  price       Decimal @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)
  
  // Classification
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  
  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Attributes
  isVeg       Boolean @default(true)
  isVegan     Boolean @default(false)
  isGlutenFree Boolean @default(false)
  spiceLevel  Int     @default(0) // 0-5 scale
  
  // Availability
  isAvailable Boolean @default(true)
  isActive    Boolean @default(true)
  
  // Kitchen
  prepTime    Int? // in minutes
  station     KitchenStation @default(MAIN)
  
  // Nutrition (optional)
  calories    Int?
  protein     Float?
  carbs       Float?
  fat         Float?
  allergens   String[] // Array of allergen strings
  
  // Relations
  variants    Variant[]
  modifiers   MenuItemModifier[]
  recipe      Recipe?
  orderItems  OrderItem[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([categoryId])
  @@index([isAvailable])
  @@index([isActive])
  @@map("menu_items")
}

model Variant {
  id     String  @id @default(cuid())
  name   String
  price  Decimal @db.Decimal(10, 2)
  
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuItemId])
  @@map("variants")
}

model ModifierGroup {
  id          String @id @default(cuid())
  name        String
  description String?
  isRequired  Boolean @default(false)
  maxSelections Int? // null means unlimited
  minSelections Int @default(0)
  
  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Relations
  modifiers    Modifier[]
  menuItems    MenuItemModifier[]
  
  isActive Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@map("modifier_groups")
}

model Modifier {
  id    String  @id @default(cuid())
  name  String
  price Decimal @db.Decimal(10, 2) @default(0)
  
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  
  isActive Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modifierGroupId])
  @@map("modifiers")
}

model MenuItemModifier {
  id              String        @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@map("menu_item_modifiers")
}

enum KitchenStation {
  MAIN
  GRILL
  FRYER
  SALAD
  DRINKS
  DESSERT
  BARISTA
}

// ========================================
// RECIPE & INVENTORY MODELS
// ========================================

model Ingredient {
  id          String @id @default(cuid())
  name        String
  description String?
  unit        String // kg, liter, piece, etc.
  
  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Costing
  avgCostPerUnit Decimal? @db.Decimal(10, 4)
  
  // Relations
  recipeItems       RecipeItem[]
  stockItems        StockItem[]
  purchaseOrderItems PurchaseOrderItem[]
  grnItems          GRNItem[]
  transferItems     TransferItem[]
  
  isActive Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@map("ingredients")
}

model Recipe {
  id          String @id @default(cuid())
  yield       Decimal @db.Decimal(10, 3) // quantity this recipe produces
  yieldUnit   String  // serving, kg, etc.
  
  menuItemId String   @unique
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  
  // Relations
  recipeItems RecipeItem[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuItemId])
  @@map("recipes")
}

model RecipeItem {
  id           String @id @default(cuid())
  quantity     Decimal @db.Decimal(10, 4)
  unit         String
  
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_items")
}

model Warehouse {
  id       String @id @default(cuid())
  name     String
  location String?
  
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  
  isActive Boolean @default(true)
  
  // Relations
  stockItems     StockItem[]
  transfersFrom  Transfer[] @relation("TransferFrom")
  transfersTo    Transfer[] @relation("TransferTo")
  purchaseOrders PurchaseOrder[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([outletId])
  @@map("warehouses")
}

model StockItem {
  id             String  @id @default(cuid())
  currentStock   Decimal @db.Decimal(10, 4) @default(0)
  reservedStock  Decimal @db.Decimal(10, 4) @default(0)
  minStockLevel  Decimal @db.Decimal(10, 4) @default(0)
  maxStockLevel  Decimal @db.Decimal(10, 4) @default(0)
  reorderPoint   Decimal @db.Decimal(10, 4) @default(0)
  
  warehouseId  String
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  outletId     String
  outlet       Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  
  // Batches
  batches StockBatch[]
  
  // Logs
  movements StockMovement[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, ingredientId])
  @@index([outletId])
  @@index([ingredientId])
  @@index([currentStock])
  @@map("stock_items")
}

model StockBatch {
  id             String    @id @default(cuid())
  batchNumber    String
  quantity       Decimal   @db.Decimal(10, 4)
  remainingQty   Decimal   @db.Decimal(10, 4)
  costPerUnit    Decimal   @db.Decimal(10, 4)
  expiryDate     DateTime?
  manufacturingDate DateTime?
  
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stockItemId])
  @@index([expiryDate])
  @@map("stock_batches")
}

model StockMovement {
  id          String            @id @default(cuid())
  type        StockMovementType
  quantity    Decimal           @db.Decimal(10, 4)
  unit        String
  reason      String?
  reference   String? // Order ID, Transfer ID, etc.
  
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  
  createdBy String?
  user      User?   @relation("StockMovementUser", fields: [createdBy], references: [id])
  
  createdAt DateTime @default(now())

  @@index([stockItemId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

enum StockMovementType {
  IN          // Stock received
  OUT         // Stock consumed/sold
  TRANSFER_IN // From another warehouse
  TRANSFER_OUT // To another warehouse
  ADJUSTMENT  // Manual adjustment
  WASTE       // Wastage/expiry
  PRODUCTION  // Used in production
}

// ========================================
// PURCHASING & VENDOR MODELS
// ========================================

model Vendor {
  id      String @id @default(cuid())
  name    String
  email   String?
  phone   String?
  address String?
  
  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Business details
  gstNumber   String?
  panNumber   String?
  paymentTerms String? // NET30, etc.
  
  // Relations
  purchaseOrders PurchaseOrder[]
  
  isActive Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@map("vendors")
}

model PurchaseOrder {
  id          String            @id @default(cuid())
  poNumber    String            @unique
  status      PurchaseOrderStatus @default(PENDING)
  totalAmount Decimal           @db.Decimal(10, 2) @default(0)
  
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  
  expectedDeliveryDate DateTime?
  notes       String?
  
  // Relations
  items PurchaseOrderItem[]
  grns  GoodsReceivedNote[]
  
  createdBy String?
  user      User?   @relation("POCreatedBy", fields: [createdBy], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String  @id @default(cuid())
  quantity    Decimal @db.Decimal(10, 4)
  unit        String
  unitPrice   Decimal @db.Decimal(10, 4)
  totalPrice  Decimal @db.Decimal(10, 2)
  
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  
  @@unique([purchaseOrderId, ingredientId])
  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceivedNote {
  id             String    @id @default(cuid())
  grnNumber      String    @unique
  receivedDate   DateTime  @default(now())
  invoiceNumber  String?
  invoiceAmount  Decimal?  @db.Decimal(10, 2)
  
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  
  items GRNItem[]
  
  receivedBy String?
  user       User?   @relation("GRNReceivedBy", fields: [receivedBy], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@map("goods_received_notes")
}

model GRNItem {
  id              String    @id @default(cuid())
  quantityOrdered Decimal   @db.Decimal(10, 4)
  quantityReceived Decimal  @db.Decimal(10, 4)
  unitPrice       Decimal   @db.Decimal(10, 4)
  expiryDate      DateTime?
  batchNumber     String?
  
  grnId        String
  grn          GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id])
  
  @@unique([grnId, ingredientId])
  @@index([grnId])
  @@map("grn_items")
}

model Transfer {
  id          String         @id @default(cuid())
  transferNumber String      @unique
  status      TransferStatus @default(PENDING)
  reason      String?
  
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  
  items TransferItem[]
  
  createdBy   String?
  user        User?   @relation("TransferCreatedBy", fields: [createdBy], references: [id])
  approvedBy  String?
  approvedAt  DateTime?
  completedAt DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
  @@map("transfers")
}

model TransferItem {
  id               String  @id @default(cuid())
  quantity         Decimal @db.Decimal(10, 4)
  quantityReceived Decimal @db.Decimal(10, 4) @default(0)
  
  transferId   String
  transfer     Transfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  
  @@unique([transferId, ingredientId])
  @@index([transferId])
  @@map("transfer_items")
}

enum PurchaseOrderStatus {
  PENDING
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// ========================================
// ORDER & POS MODELS
// ========================================

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  type        OrderType   @default(DINE_IN)
  status      OrderStatus @default(PENDING)
  
  // Customer & Location
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  
  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id])
  
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])
  
  // Amounts
  subtotal      Decimal @db.Decimal(10, 2) @default(0)
  discountAmount Decimal @db.Decimal(10, 2) @default(0)
  taxAmount     Decimal @db.Decimal(10, 2) @default(0)
  tipAmount     Decimal @db.Decimal(10, 2) @default(0)
  totalAmount   Decimal @db.Decimal(10, 2) @default(0)
  
  // Delivery specific
  deliveryAddress String?
  deliveryFee     Decimal? @db.Decimal(10, 2)
  deliveryTime    DateTime?
  
  // Kitchen
  kotNumber    String?
  estimatedTime Int? // in minutes
  
  // Notes
  notes        String?
  customerNotes String?
  
  // Relations
  items    OrderItem[]
  payments Payment[]
  kotTickets KOTTicket[]
  feedback Feedback[]
  
  // Staff
  createdBy String?
  user      User?   @relation("OrderUser", fields: [createdBy], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outletId])
  @@index([customerId])
  @@index([tableId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  
  // Customizations
  variantId String?
  modifiers Json? // Array of modifier objects
  notes     String?
  
  // Kitchen status
  status KitchenItemStatus @default(PENDING)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([menuItemId])
  @@index([status])
  @@map("order_items")
}

model KOTTicket {
  id         String           @id @default(cuid())
  kotNumber  String           @unique
  station    KitchenStation
  status     KOTStatus        @default(NEW)
  priority   Int              @default(0)
  
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Timing
  estimatedTime Int? // in minutes
  startedAt     DateTime?
  completedAt   DateTime?
  
  notes String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([station])
  @@index([status])
  @@index([createdAt])
  @@map("kot_tickets")
}

model Payment {
  id          String        @id @default(cuid())
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Payment gateway data
  transactionId String?
  gatewayResponse Json?
  
  // For split payments
  notes String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@map("payments")
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  ONLINE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  CANCELLED
  REFUNDED
}

enum KitchenItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum KOTStatus {
  NEW
  IN_PROGRESS
  READY
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// ========================================
// RESERVATION MODELS
// ========================================

model Reservation {
  id           String            @id @default(cuid())
  reservationNumber String       @unique
  partySize    Int
  date         DateTime
  time         DateTime
  duration     Int               @default(120) // in minutes
  status       ReservationStatus @default(CONFIRMED)
  
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  
  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id])
  
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])
  
  // Deposit
  depositAmount Decimal? @db.Decimal(10, 2)
  depositPaid   Boolean  @default(false)
  
  // Communication
  notes         String?
  specialRequests String?
  reminderSent  Boolean @default(false)
  
  createdBy String?
  user      User?   @relation("ReservationCreatedBy", fields: [createdBy], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outletId])
  @@index([customerId])
  @@index([date])
  @@index([status])
  @@map("reservations")
}

enum ReservationStatus {
  CONFIRMED
  SEATED
  NO_SHOW
  CANCELLED
  COMPLETED
}

// ========================================
// CUSTOMER & CRM MODELS
// ========================================

model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String?
  phone       String?
  dateOfBirth DateTime?
  
  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Address
  address String?
  city    String?
  state   String?
  pincode String?
  
  // Loyalty
  loyaltyAccount LoyaltyAccount?
  
  // Analytics
  totalOrders   Int     @default(0)
  totalSpent    Decimal @db.Decimal(10, 2) @default(0)
  avgOrderValue Decimal @db.Decimal(10, 2) @default(0)
  lastOrderAt   DateTime?
  
  // Relations
  orders       Order[]
  reservations Reservation[]
  feedback     Feedback[]
  
  // Marketing consent
  emailOptIn Boolean @default(false)
  smsOptIn   Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@index([email])
  @@index([phone])
  @@map("customers")
}

model LoyaltyAccount {
  id         String @id @default(cuid())
  points     Int    @default(0)
  tier       String @default("BRONZE")
  
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  // Transactions
  transactions LoyaltyTransaction[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tier])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id        String              @id @default(cuid())
  type      LoyaltyTransactionType
  points    Int
  reason    String?
  reference String? // Order ID, etc.
  
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@index([loyaltyAccountId])
  @@index([type])
  @@map("loyalty_transactions")
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTED
}

// ========================================
// MARKETING & CAMPAIGNS
// ========================================

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  
  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Targeting
  targetSegment Json? // Customer segmentation criteria
  
  // Content
  subject     String?
  content     String?
  templateId  String?
  
  // Scheduling
  scheduledAt DateTime?
  startDate   DateTime?
  endDate     DateTime?
  
  // Metrics
  sentCount     Int @default(0)
  openCount     Int @default(0)
  clickCount    Int @default(0)
  conversionCount Int @default(0)
  
  createdBy String?
  user      User?   @relation("CampaignCreatedBy", fields: [createdBy], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@map("campaigns")
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  description String?
  type        CouponType @default(PERCENTAGE)
  value       Decimal    @db.Decimal(10, 2)
  
  // Multi-tenant
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Conditions
  minOrderValue Decimal? @db.Decimal(10, 2)
  maxDiscount   Decimal? @db.Decimal(10, 2)
  usageLimit    Int?
  usageCount    Int      @default(0)
  
  // Validity
  validFrom DateTime
  validTill DateTime
  isActive  Boolean  @default(true)
  
  createdBy String?
  user      User?   @relation("CouponCreatedBy", fields: [createdBy], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([code])
  @@index([validFrom, validTill])
  @@map("coupons")
}

enum CampaignType {
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  PAUSED
  COMPLETED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

// ========================================
// STAFF & HR MODELS
// ========================================

model Shift {
  id        String    @id @default(cuid())
  name      String
  startTime DateTime
  endTime   DateTime
  
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  
  // Staff assignments
  userId String?
  user   User?   @relation(fields: [userId], references: [id])
  
  // Timesheets
  timesheets Timesheet[]
  
  isActive Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outletId])
  @@index([userId])
  @@index([startTime])
  @@map("shifts")
}

model Timesheet {
  id         String    @id @default(cuid())
  clockIn    DateTime
  clockOut   DateTime?
  breakTime  Int       @default(0) // in minutes
  totalHours Decimal   @db.Decimal(5, 2) @default(0)
  
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])
  
  // Location tracking
  clockInLocation  String?
  clockOutLocation String?
  
  notes String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([clockIn])
  @@map("timesheets")
}

// ========================================
// FEEDBACK & REVIEWS
// ========================================

model Feedback {
  id      String       @id @default(cuid())
  rating  Int          // 1-5 stars
  comment String?
  type    FeedbackType @default(GENERAL)
  
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])
  
  // Response
  response   String?
  respondedAt DateTime?
  respondedBy String?
  
  isPublic Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([orderId])
  @@index([rating])
  @@index([type])
  @@map("feedback")
}

enum FeedbackType {
  GENERAL
  FOOD_QUALITY
  SERVICE
  AMBIANCE
  DELIVERY
  COMPLAINT
}

// ========================================
// BILLING & SUBSCRIPTION MODELS
// ========================================

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  price       Decimal  @db.Decimal(10, 2)
  interval    String   // monthly, yearly
  features    Json     // Array of feature flags
  limits      Json     // Usage limits (outlets, staff, notifications)
  
  // Stripe/Razorpay IDs
  stripeProductId String?
  stripePriceId   String?
  razorpayPlanId  String?
  
  isActive Boolean @default(true)
  
  // Relations
  tenants       Tenant[]
  subscriptions Subscription[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id                String             @id @default(cuid())
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])
  
  // Billing
  stripeSubscriptionId String?
  razorpaySubscriptionId String?
  
  // Trial
  trialStart DateTime?
  trialEnd   DateTime?
  
  // Usage tracking
  usageEvents UsageEvent[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

model UsageEvent {
  id       String    @id @default(cuid())
  type     UsageType
  quantity Int       @default(1)
  metadata Json?
  
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@index([subscriptionId])
  @@index([type])
  @@index([createdAt])
  @@map("usage_events")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  UNPAID
}

enum UsageType {
  NOTIFICATION_SMS
  NOTIFICATION_EMAIL
  NOTIFICATION_WHATSAPP
  API_CALL
  WEBHOOK_CALL
}

// ========================================
// INTEGRATIONS & WEBHOOKS
// ========================================

model Connector {
  id          String          @id @default(cuid())
  name        String
  type        ConnectorType
  config      Json            // Connection configuration
  isActive    Boolean         @default(true)
  
  // Multi-tenant (optional - some connectors might be global)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // OAuth tokens
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  
  webhookEvents WebhookEvent[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([type])
  @@map("connectors")
}

model WebhookEvent {
  id         String @id @default(cuid())
  eventType  String
  payload    Json
  signature  String?
  processed  Boolean @default(false)
  retryCount Int     @default(0)
  
  connectorId String?
  connector   Connector? @relation(fields: [connectorId], references: [id])
  
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  processedAt DateTime?
  error       String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventType])
  @@index([processed])
  @@index([tenantId])
  @@map("webhook_events")
}

enum ConnectorType {
  DELIVERY_SWIGGY
  DELIVERY_ZOMATO
  DELIVERY_UBER_EATS
  PAYMENT_STRIPE
  PAYMENT_RAZORPAY
  SMS_TWILIO
  EMAIL_SENDGRID
  WHATSAPP_META
}

// ========================================
// AUDIT & COMPLIANCE
// ========================================

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // CREATE, UPDATE, DELETE, etc.
  resource  String   // table name or resource type
  resourceId String? // ID of the affected resource
  oldValues Json?    // Previous values for updates
  newValues Json?    // New values for creates/updates
  
  userId String?
  user   User?   @relation(fields: [userId], references: [id])
  
  // Context
  ipAddress String?
  userAgent String?
  metadata  Json?
  
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}